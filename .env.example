# --- обязательное ---
# токен Telegram-бота из @BotFather
TG_TOKEN=123456:ABCdefGhIjKlmNoPqrStUvWxYz

# --- модели ---
# claude CLI должен быть установлен и авторизован (см. README).
CLAUDE_MODEL=haiku          # разбор текстовых сообщений
TICKET_MODEL=sonnet         # чтение файлов (билеты, афиши, приглашения)
WHISPER_MODEL=base          # faster-whisper для голосовых

# --- iCloud CalDAV (необязательно) ---
# если заполнить обе строки — события зеркалятся в календарь iCloud (двусторонний синк).
# ICLOUD_APP_PASSWORD — пароль приложения Apple ID (appleid.apple.com), НЕ основной пароль.
ICLOUD_EMAIL=
ICLOUD_APP_PASSWORD=
ICLOUD_CALENDAR=Семья

# --- прочее (есть значения по умолчанию) ---
# FAMILY_DB=/opt/family-bot/family.db   # путь к SQLite (по умолчанию рядом с пакетом)
# WHISPER_DIR=/opt/family-bot/models    # куда качать модель whisper
# BOT_TZ=Europe/Moscow                  # таймзона
# MAX_USERS=2                           # сколько человек привязываются автоматически
# MORNING_HOUR=8                        # час утренней сводки
